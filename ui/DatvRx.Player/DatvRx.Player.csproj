<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DatvRx.Player</AssemblyName>
    <Product>DATVision by HB9IIU</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>../../assets/branding/datvision.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/branding/datvision.ico" LogicalName="DATVision.Branding.Icon" />
    <EmbeddedResource Include="../../assets/branding/datvision-wordmark.png" LogicalName="DATVision.Branding.Wordmark" />
  </ItemGroup>
</Project>
